      "extractionState": "manual"
    },
    "轻点选取 · 长按拖动连选 · 自动分段拼合": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap to pick · long-press then drag to sweep · paragraph breaks preserved"
