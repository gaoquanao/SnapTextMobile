    "NSPhotoLibraryUsageDescription" : {
      "comment" : "Privacy - Photo Library Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "SnapText needs photo access to read your latest screenshots for on-device text recognition."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "SnapText necesita acceso a Fotos para leer tus capturas recientes y reconocer texto en el dispositivo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "SnapTextは最新のスクリーンショットを読み取り、デバイス上で文字認識するために写真へのアクセスが必要です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "SnapText가 최신 스크린샷을 읽어 기기에서 문자를 인식하려면 사진 접근 권한이 필요합니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "拾文需要访问相册，以读取您最近的截图进行端侧文字识别。"
          }
        }
      }
    }
  },
  "version" : "1.0"
